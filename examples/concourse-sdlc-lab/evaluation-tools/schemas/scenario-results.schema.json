{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRAD scenario evaluation",
  "type": "object",
  "required": ["schemaVersion", "runId", "sourceCatalogSha256", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string" },
    "sourceCatalogSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expectedRoute", "levels"],
        "properties": {
          "id": { "type": "string" },
          "expectedRoute": { "type": "string" },
          "selectedRoute": { "type": ["string", "null"] },
          "nativeInvocationVerified": { "type": "boolean" },
          "levels": {
            "type": "object",
            "required": ["L1", "L2", "L3", "L4", "L5"],
            "additionalProperties": {
              "type": "object",
              "required": ["status", "evidenceId"],
              "properties": {
                "status": { "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "UNSUPPORTED", "NOT_RUN"] },
                "evidenceId": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
