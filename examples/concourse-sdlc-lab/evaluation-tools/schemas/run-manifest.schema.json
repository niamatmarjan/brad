{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRAD evaluation run manifest",
  "type": "object",
  "required": ["schemaVersion", "runId", "status", "startedAt", "bradBaseline", "environment", "application"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["IN_PROGRESS", "PARTIAL", "COMPLETE"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "bradBaseline": {
      "type": "object",
      "required": ["version", "tag", "commit", "packageSha256"],
      "properties": {
        "version": { "const": "0.4.1" },
        "tag": { "const": "v0.4.1" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "packageSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "environment": { "type": "object" },
    "application": { "type": "object" }
  }
}
