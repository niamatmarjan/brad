{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRAD evaluation event",
  "type": "object",
  "required": ["eventId", "runId", "timestamp", "timestampMeaning", "eventType", "status", "summary", "evidenceIds"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "timestampMeaning": { "enum": ["occurred_at", "captured_at"] },
    "occurredAt": { "type": ["string", "null"], "format": "date-time" },
    "eventType": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "UNSUPPORTED", "NOT_RUN", "INFO"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "durationMs": { "type": ["number", "null"], "minimum": 0 },
    "tokenUsage": { "type": ["object", "null"] }
  }
}
