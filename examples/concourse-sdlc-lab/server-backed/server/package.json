{
  "name": "@concourse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/spec/*.spec.js",
    "seed": "npm run build && node dist/src/seed.js",
    "start": "node dist/src/index.js",
    "dev": "npm run build && npm start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
